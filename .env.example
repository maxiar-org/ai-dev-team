# Copia este archivo a .env y completa los valores. .env NUNCA se sube a git.

# Token fine-grained de maxiar-ai-dev-team-bot (dueño del recurso: maxiar-org)
GITHUB_TOKEN=
GITHUB_ORG=maxiar-org
# Repos que atiende el dispatcher, separados por coma
REPOS=agent-playground,qr-generator,ai-dev-team
# Usuarios que pueden dar órdenes con @openhands y a quienes se les pide review
ALLOWED_USERS=maxiar
BOT_LOGIN=maxiar-ai-dev-team-bot
DEFAULT_DEV_ENGINE=codex
# Número del tablero de GitHub Projects de la organización (vacío = sin tablero).
# El token del bot necesita el permiso de organización Projects: Read and write.
PROJECT_NUMBER=1
# Motor del rol QA (prueba la app con Playwright) y del rol de documentación
QA_ENGINE=codex
DOCS_ENGINE=claude
# Repos donde los agentes solo pueden tocar documentación (agent:dev no arranca)
DOCS_ONLY_REPOS=ai-dev-team

# Genera cada uno con: openssl rand -hex 32
CANVAS_API_KEY=
OH_SECRET_KEY=

# `claude setup-token` con la cuenta Claude PRO del piloto (NUNCA la Max de clientes)
CLAUDE_CODE_OAUTH_TOKEN=
# Túnel con nombre "ai-dev-team" de Cloudflare Zero Trust (Networks → Tunnels): el valor después de --token
TUNNEL_TOKEN=
# Fechas de vencimiento (AAAA-MM-DD). El watchdog avisa con un issue [ops] 14 días antes
GITHUB_TOKEN_EXPIRES=
CLAUDE_TOKEN_EXPIRES=
# Mini-PC: getent group docker | cut -d: -f3, id -u aidev, id -g aidev (el operador escribe en el repo con ese usuario)
DOCKER_GID=
AIDEV_UID=
AIDEV_GID=
# Contenido de ~/.codex/auth.json en UNA línea (ver README, sección Credenciales)
CODEX_AUTH_JSON=
